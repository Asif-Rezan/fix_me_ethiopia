rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  function signed() { return request.auth != null; }
  function owner(uid) { return signed() && request.auth.uid == uid; }
  function admin() { return signed() && request.auth.token.admin == true; }
  function image() { return request.resource != null && request.resource.size < 10 * 1024 * 1024 && request.resource.contentType.matches('image/(jpeg|png|webp)'); }
  match /kyc/{uid}/{file} { allow read: if owner(uid) || admin(); allow create: if owner(uid) && image(); allow update,delete: if false; }
  match /profiles/{uid}/{file} { allow read: if signed(); allow write: if owner(uid) && image(); }
  match /bookings/{bookingId}/{uid}/{file} {
   function participant() { let b = firestore.get(/databases/(default)/documents/bookings/$(bookingId)).data; return signed() && (b.customerId == request.auth.uid || b.technicianId == request.auth.uid); }
   allow read: if participant(); allow create: if participant() && owner(uid) && image(); allow update,delete: if false;
  }
  match /{path=**} { allow read,write: if false; }
 }
}
